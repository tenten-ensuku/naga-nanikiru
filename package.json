{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prebuild": "npm run build:supabase-client",
    "build:supabase-client": "node scripts/build-supabase-client.mjs",
    "runtime:config": "node scripts/write-runtime-config.mjs",
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:drill": "node --test tests/drill-answer-flow.test.mjs tests/comment-tile-rendering.test.mjs tests/comment-repair.test.mjs tests/youtube-comment-rendering.test.mjs tests/drill-ux-v44.test.mjs tests/naga-generator-v44.test.mjs tests/naga-report-route.test.mjs tests/naga-capture-function.test.mjs tests/generator-ui-v46.test.mjs tests/permissions-ui-v47.test.mjs tests/supabase-foundation-v46.test.mjs tests/team-editor-v130.test.mjs tests/personal-state-v131.test.mjs tests/duplicate-question-v153.test.mjs && node scripts/validate-question-data.mjs",
    "import:questions": "node scripts/import-existing-questions.mjs",
    "supabase:types": "supabase gen types typescript --local > supabase/database.types.ts",
    "audit:reach": "node scripts/sync-naga-reach.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .site-stage* --ignore-pattern public/supabase-sync-v46.js --ignore-pattern public/supabase-sync-v47.js --ignore-pattern public/supabase-sync-v48.js",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-loading-skeleton": "3.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "supabase": "2.110.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
